{
  "expo": {
    "name": "Moon",
    "slug": "moon-epub-reader",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F0ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moon.epubreader"
    },
    "android": {
      "package": "com.moon.epubreader",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F0ED"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-document-picker"
    ]
  }
}
